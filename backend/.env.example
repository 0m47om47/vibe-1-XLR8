# MongoDB Atlas connection string (must point at a replica set — every Atlas cluster, including free M0, is one).
MONGODB_URI=
# Database name
MONGODB_DB=

# --- Optional (defaults shown) ---
# Travel time of one run, in minutes (departure → arrival; also the clash window)
# TRIP_DURATION_MINUTES=15
# Seats in the Toto — max passengers on one (shared) run
# TOTO_CAPACITY=5
# Max passengers in a single request (capped at TOTO_CAPACITY)
# MAX_PASSENGERS=5
# Session lifetime in days
# SESSION_TTL_DAYS=7

# The frontend's browser origin. Mutating requests from any other origin are rejected (CSRF defence),
# and this origin is the only one allowed for CORS with credentials.
FRONTEND_ORIGIN=http://localhost:3000
