# MongoDB Atlas connection string (must point at a replica set — every Atlas cluster, including free M0, is one).
MONGODB_URI=
# Database name
MONGODB_DB=

# --- Optional (defaults shown) ---
# Port the Express server listens on
# PORT=4000
# Default trip duration used for clash detection, in minutes
# TRIP_DURATION_MINUTES=30
# Maximum passengers per request
# MAX_PASSENGERS=6
# Session lifetime in days
# SESSION_TTL_DAYS=7

# The frontend's browser origin. Mutating requests from any other origin are rejected (CSRF defence),
# and this origin is the only one allowed for CORS with credentials.
FRONTEND_ORIGIN=http://localhost:3000
